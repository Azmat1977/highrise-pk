# Highrise.pk — production environment template (NAMES / placeholders only)
# NEVER commit real secrets. Keep .env.local outside source control.

# ── Canonical site URLs ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://highrise.pk
NEXT_PUBLIC_APP_URL=https://highrise.pk
NEXTAUTH_URL=https://highrise.pk

# ── Authentication / security ────────────────────────────────────────────────
# Use separate random values. Do not reuse one secret for every purpose.
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_64_HEX_OR_LONGER
OTP_PEPPER=REPLACE_WITH_RANDOM_64_HEX
SIGNUP_TEMP_SECRET=REPLACE_WITH_RANDOM_64_HEX
RATE_LIMIT_KEY_SECRET=REPLACE_WITH_RANDOM_64_HEX
SECURITY_LOG_HASH_SECRET=REPLACE_WITH_RANDOM_64_HEX
SECURITY_LOG_HMAC_SECRET=REPLACE_WITH_RANDOM_64_HEX
CRON_SECRET=REPLACE_WITH_RANDOM_64_HEX
AUTH_DEBUG=0
REQUIRE_ADMIN_2FA=0
REQUIRE_CNIC_FOR_AGENT_ONBOARDING=1

# Optional abuse-control lists (comma-separated where supported)
BLOCKED_EMAIL_DOMAINS=
BLOCKED_PASSWORDS=
RATE_LIMIT_BLOCKED_IPS=
RATE_LIMIT_TRUSTED_IPS=

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT=10000
MONGODB_CONNECT_TIMEOUT=30000
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_MAX_RETRY_ATTEMPTS=5
MONGODB_RETRY_DELAY_MS=1000

# ── Phase 0 isolation (guarded write tooling) ───────────────────────────────
# Dedicated NON-PRODUCTION database for scripts + /api/dev/seed.
# Example (local MongoDB): MONGODB_URI_TEST=mongodb://127.0.0.1:27017/highrise_test
MONGODB_URI_TEST=
# Demo seed endpoint stays disabled unless explicitly set to 1 (never in production).
DEMO_SEED_ENABLED=0

# ── Cloudinary (SERVER ONLY — no browser upload preset) ─────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── KYC / property cryptography ──────────────────────────────────────────────
# KYC_ENC_KEY must be BASE64 for exactly 32 random bytes.
KYC_ENC_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
KYC_HASH_SECRET=REPLACE_WITH_RANDOM_64_HEX
PROPERTY_HASH_SECRET=REPLACE_WITH_RANDOM_64_HEX
PROPERTY_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Upstash Redis / rate limiting ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# MUST stay false/0 in production.
RATE_LIMIT_DISABLED=false

# ── Email / SMTP ─────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Highrise.pk
RESEND_API_KEY=
ADMIN_EMAIL=
ADMIN_QUOTA_ALERT_EMAIL=
SALES_EMAIL=

# ── Maps ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── AI (enable only services you actually use) ───────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=
GROQ_DAILY_LIMIT=14400
GROQ_WARN_THRESHOLD=75
GROQ_PRIORITY_THRESHOLD=90
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Business contact ─────────────────────────────────────────────────────────
WHATSAPP_NUMBER=
